{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "time": {
      "default": {},
      "type": "object",
      "properties": {
        "day": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "date": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      },
      "additionalProperties": {}
    },
    "player": {
      "default": {},
      "type": "object",
      "properties": {
        "area": {
          "default": {},
          "type": "object",
          "properties": {
            "region": {
              "default": "城镇",
              "type": "string"
            },
            "place": {
              "default": "玩家的家",
              "type": "string"
            }
          },
          "additionalProperties": {}
        },
        "energy": {
          "default": {},
          "type": "object",
          "properties": {
            "current": {
              "default": 4,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max": {
              "default": 4,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": {}
        },
        "party": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": {}
    },
    "locations": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "present": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": {}
      }
    },
    "_locationsInit": {
      "default": false,
      "type": "boolean"
    },
    "outfits": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "states": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "source": {
            "default": "自动",
            "type": "string",
            "enum": [
              "自动",
              "事件"
            ]
          }
        },
        "required": [
          "state"
        ],
        "additionalProperties": {}
      }
    },
    "characters": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "角色名"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "known": {
            "type": "boolean"
          },
          "affection": {
            "type": "number"
          },
          "stage": {
            "default": "陌生",
            "type": "string",
            "enum": [
              "陌生",
              "有所保留",
              "熟悉",
              "亲近",
              "特别在意",
              "明确心意",
              "心意满溢",
              "恋人",
              "被拒绝"
            ]
          },
          "confessed": {
            "type": "boolean"
          }
        },
        "required": [
          "affection",
          "confessed"
        ],
        "additionalProperties": {}
      }
    },
    "quests": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "委托 ID"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "default": "进行中",
            "type": "string",
            "enum": [
              "进行中",
              "可提交",
              "已完成",
              "已过期"
            ]
          },
          "progress": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "goal": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "characters"
  ],
  "additionalProperties": {}
}